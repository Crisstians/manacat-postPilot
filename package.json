{
  "name": "manacat-post",
  "productName": "Manacat PostPilot",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crisstians/manacat-postPilot.git"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --port 5180 --strictPort",
    "dev:electron": "tsc -p tsconfig.electron.json && tsc -p tsconfig.preload.json && wait-on tcp:5180 && cross-env VITE_DEV_SERVER_URL=http://localhost:5180 electron .",
    "build": "tsc -b && vite build && tsc -p tsconfig.electron.json && tsc -p tsconfig.preload.json",
    "prepare:icons": "node scripts/prepare-icons.mjs",
    "build:app": "npm run prepare:icons && npm run build && electron-builder --win",
    "build:release": "npm run prepare:icons && npm run build && electron-builder --win --publish always",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "flyonui": "^2.4.1",
    "jszip": "^3.10.1",
    "konva": "^10.3.0",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-konva": "^19.2.5",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  },
  "main": "dist-electron/electron/main.js",
  "build": {
    "appId": "com.manacat.postpilot",
    "productName": "Manacat PostPilot",
    "artifactName": "Manacat-PostPilot-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "Crisstians",
        "repo": "manacat-postPilot"
      }
    ],
    "fileAssociations": [
      {
        "ext": "pman",
        "name": "Manacat PostPilot Document",
        "description": "Document Manacat PostPilot",
        "role": "Editor",
        "icon": "icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PostPilot",
      "menuCategory": "Manacat",
      "uninstallDisplayName": "Manacat PostPilot"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/assets/templatesPostari",
        "to": "templatesPostari"
      },
      {
        "from": "src/assets/fonts",
        "to": "fonts"
      },
      {
        "from": "src/assets/unitati",
        "to": "unitati"
      }
    ]
  }
}
